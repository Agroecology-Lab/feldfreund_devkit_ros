export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

test -f /opt/ros/jazzy/local_setup.bash && \
    source /opt/ros/jazzy/local_setup.bash
test -f /workspace/install/local_setup.bash && \
    source /workspace/install/local_setup.bash

# CycloneDDS — raise participant cap (default ~120 exhausted by devkit + Nav2 burst)
export CYCLONEDDS_URI='<CycloneDDS><Domain><Discovery><MaxAutoParticipantIndex>200</MaxAutoParticipantIndex></Discovery></Domain></CycloneDDS>'

# Mesa — pin to llvmpipe (no /dev/dri in container; harmless if GPU appears later)
export MESA_LOADER_DRIVER_OVERRIDE=llvmpipe
export GALLIUM_DRIVER=llvmpipe

# virtual_maize_field — gz needs this to resolve maize/ground/texture models
export GZ_SIM_RESOURCE_PATH=/workspace/install/virtual_maize_field/share/virtual_maize_field/models
