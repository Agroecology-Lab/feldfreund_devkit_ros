# Drop-in test map with real metric positions — no GPS required.
#
# Layout (all positions in map-frame metres):
#
#   HOME(0,0) ── HL_W(5,0) ──────────────────── HL_E(33,0)
#                  │  R1_IN(5, 4) ──row──► R1_OUT(33, 4) ─┐
#                  │  R2_IN(5, 8) ──row──► R2_OUT(33, 8) ─┤
#                  │  R3_IN(5,-4) ──row──► R3_OUT(33,-4) ─┤
#                  └──R4_IN(5,-8) ──row──► R4_OUT(33,-8) ─┘
#                                                          │
#                       HL_W ◄────────────────────────────┘
#
# Row edges use limbic_row_follow; all headland moves use navigate_to_pose.
# Robot flow per row:
#   HL_W → R{n}_IN (navigate_to_pose)
#         → R{n}_OUT (limbic_row_follow)
#         → HL_E    (navigate_to_pose)
#         → HL_W    (navigate_to_pose)  ← ready for next row
#
#
# GPS origin matches existing mixed_test_map origin so the
# Leaflet map renders in the right place.

meta:
  last_updated: 15-05-2026_12-00-00
  origin:
    latitude: 53.312012987
    longitude: -0.45199058
    altitude: 0
metric_map: test_map
name: test_map
pointset: test_map
transformation:
  topo_frame_id: map
  parent: odom
  rotation:
    w: 1.0
    x: 0.0
    y: 0.0
    z: 0.0
  translation:
    x: 0.0
    y: 0.0
    z: 0.0

definitions:
  default_bt: "<root main_tree_to_execute=\"MainTree\">\n  <BehaviorTree ID=\"MainTree\"\
    >\n    <PipelineSequence name=\"NavigateWithReplanning\">\n      <ComputePathToPose\
    \ goal=\"{goal}\" path=\"{path}\" planner_id=\"GridBased\"/>\n      <FollowPath\
    \ path=\"{path}\" controller_id=\"FollowPath\"/>\n    </PipelineSequence>\n  </BehaviorTree>\n\
    </root>\n"
  goal_align_bt: "<root main_tree_to_execute=\"MainTree\">\n  <BehaviorTree ID=\"\
    MainTree\">\n    <PipelineSequence name=\"NavigateWithReplanning\">\n      <ComputePathToPose\
    \ goal=\"{goal}\" path=\"{path}\" planner_id=\"GridBased\"/>\n      <FollowPath\
    \ path=\"{path}\" controller_id=\"FollowPath\"/>\n    </PipelineSequence>\n  </BehaviorTree>\n\
    </root>\n"
  row_traversal_bt: "<root main_tree_to_execute=\"MainTree\">\n  <BehaviorTree ID=\"\
    MainTree\">\n    <PipelineSequence name=\"NavigateWithReplanning\">\n      <ComputePathThroughPoses\
    \ goals=\"{goals}\" path=\"{path}\" planner_id=\"GridBased\"/>\n      <FollowPath\
    \ path=\"{path}\" controller_id=\"FollowPath\"/>\n    </PipelineSequence>\n  </BehaviorTree>\n\
    </root>\n"

actions:
  navigate_to_pose:
    composable: false
    action_type: nav2_msgs.action.NavigateToPose
    action_server: /navigate_to_pose
    action_goal_template:
      pose:
        header:
          frame_id: ${node.nav_frame}
        pose: ${node.pose}
      behavior_tree: ${definitions.default_bt}
  navigate_to_poses:
    composable: true
    action_type: nav2_msgs.action.NavigateThroughPoses
    action_server: /navigate_through_poses
    action_goal_template:
      poses:
      - header:
          frame_id: ${node.nav_frame}
        pose: ${node.pose}
      behavior_tree: ${definitions.default_bt}
  goal_align:
    composable: false
    action_type: nav2_msgs.action.NavigateToPose
    action_server: /navigate_to_pose
    action_goal_template:
      pose:
        header:
